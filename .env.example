# Copie para casaria-api/.env e preencha. Nunca versione o .env.

# development, production ou test
NODE_ENV=
# Porta HTTP da API (opcional, padrão 3000)
# PORT=
# Domínio da plataforma, sem esquema nem porta (ex.: localhost em desenvolvimento)
APP_DOMAIN=
# postgresql://usuario:senha@host:5432/banco (no compose local: casaria / casaria_dev / casaria)
DATABASE_URL=
# redis://host:6379
REDIS_URL=
# 32 bytes em base64, gerados com: openssl rand -base64 32. Guardar fora do repositório:
# perdida, CPF e tokens cifrados ficam irrecuperáveis.
ENCRYPTION_KEY=

# Sessão (cookie httpOnly guardado no Redis): 32 caracteres ou mais, gerados com
# openssl rand -base64 32. Trocar derruba todas as sessões.
SESSION_SECRET=
# OAuth do Google (um cliente por ambiente). URL de retorno a cadastrar no Google:
# produção https://api.<dominio>/v1/auth/google/callback;
# desenvolvimento http://app.localhost:5173/v1/auth/google/callback (o Vite repassa à API).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage compatível com S3 das imagens (spec 006). No compose local (SeaweedFS):
# endpoint http://localhost:8333 com path style; o weed mini aceita qualquer chave.
# Em produção, o bucket deve dar leitura pública só às versões (.webp e .jpg) sob weddings/,
# sem listagem, e as credenciais devem ficar restritas a ele.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true para endpoints que exigem o bucket no caminho (SeaweedFS, MinIO); padrão false.
# S3_FORCE_PATH_STYLE=
# URL pública que serve as chaves do bucket, sem barra no fim (ex.: https://cdn.<dominio>/<bucket>).
# Só em desenvolvimento pode ser o caminho /storage/<bucket>: o Vite repassa ao SeaweedFS na mesma
# origem, e as imagens funcionam no painel local e pelo túnel do ngrok.
S3_PUBLIC_BASE_URL=

# Aplicação do Mercado Pago (spec 012), criada no painel de desenvolvedor
# (https://www.mercadopago.com.br/developers/panel/app). Client ID e Client Secret da aplicação;
# a public key e o access token são de cada casal, obtidos pelo OAuth. URL de redirecionamento a
# cadastrar na aplicação: https://api.<dominio>/v1/payments/oauth/callback (em desenvolvimento,
# http://app.localhost:5173/v1/payments/oauth/callback). Webhook (tópicos "Order (Mercado Pago)" e
# "Vinculação de aplicações"): https://api.<dominio>/v1/webhooks/mercadopago; no local, pelo túnel.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Chave secreta das notificações (Webhooks > Configurar notificação > revelar a chave).
MP_WEBHOOK_SECRET=
# Campo da resposta do OAuth com a public key do casal (opcional, padrão public_key).
# MP_OAUTH_PUBLIC_KEY_FIELD=

# Pasta do build do web servida nos subdomínios dos casamentos, com o index.html e as meta do link
# (spec 007). Obrigatória em produção; no desenvolvimento o site roda no Vite. Em produção é o
# volume compartilhado em que o container da casaria-web publica o build (/srv/web-dist); a API lê
# o index.html ao subir, então reinicie a api depois de cada deploy do web.
# WEB_DIST_DIR=

# Cabeçalho com o IP real do visitante posto pela borda; atrás do Cloudflare, cf-connecting-ip.
# Sem ela, vale o IP que chega ao Express. Não use sem o proxy na frente: o cabeçalho seria forjável.
# CLIENT_IP_HEADER=

# Só em desenvolvimento: endereço https do túnel (ex.: ngrok) que abre o painel, para o OAuth do
# Google e do Mercado Pago voltar a ele (cadastre as URLs de retorno com esse endereço). Vazia, o
# painel fica em http://app.localhost:5173. Ignorada fora de development.
# DEV_PANEL_URL=
